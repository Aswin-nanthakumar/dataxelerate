# URBANFLOW AI — Backend environment
# Copy to .env and fill in production values. NEVER commit real secrets.

NODE_ENV=development
PORT=4000

# --- Data ---
# Leave DATABASE_URL empty to boot the in-memory adapter (CI/demo mode).
DATABASE_URL=postgres://user:password@host:5432/urbanflow
DB_SSL=false
REDIS_URL=

# --- Auth (use 64+ char random strings in production) ---
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-urbanflow
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-urbanflow
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
BCRYPT_ROUNDS=10

# --- AI service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=urbanflow-internal
AI_SERVICE_TIMEOUT_MS=15000

# --- LLM providers (optional — deterministic fallback when empty) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Storage (optional) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Security ---
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Seed ---
SEED_PASSWORD=Urbanflow#2026
